[Unit]
Description=Check and safely update CLIProxyAPI
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=jamie
Group=jamie
ExecStart=/home/jamie/docker/cli-proxy-api/auto-update.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/jamie/docker/cli-proxy-api /run/lock
PrivateTmp=true
NoNewPrivileges=true
